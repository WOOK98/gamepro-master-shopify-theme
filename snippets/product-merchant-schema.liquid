{%- liquid
  assign canonical_origin = 'https://migmaster.shop'
  assign product_url = canonical_origin | append: '/products/' | append: product.handle
  assign selected_variant = product.selected_or_first_available_variant
  assign product_sku_source = selected_variant.sku | default: selected_variant.id
  assign product_schema_sku = product_sku_source | handleize | upcase
  assign product_description = product.description | strip_html | strip_newlines | truncate: 500
  assign shipping_policy_url = canonical_origin | append: '/policies/shipping-policy'
  assign return_policy_url = canonical_origin | append: '/policies/refund-policy'
-%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "@id": {{ product_url | append: '#product' | json }},
    "name": {{ product.title | json }},
    "url": {{ product_url | json }},
    "description": {{ product_description | json }},
    "sku": {{ product_schema_sku | json }},
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | default: shop.name | json }}
    },
    "image": [
      {%- if product.images.size > 0 -%}
        {%- for product_image in product.images limit: 3 -%}
          {%- liquid
            assign product_image_url = product_image | image_url: width: 1200
            unless product_image_url contains '://'
              assign product_image_url = product_image_url | prepend: 'https:'
            endunless
          -%}
          {{ product_image_url | json }}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      {%- else -%}
        {%- liquid
          assign fallback_image_url = 'mig-flash-icon-512.png' | asset_url
          unless fallback_image_url contains '://'
            assign fallback_image_url = fallback_image_url | prepend: 'https:'
          endunless
        -%}
        {{ fallback_image_url | json }}
      {%- endif -%}
    ],
    "offers": [
      {%- for variant in product.variants -%}
        {%- liquid
          assign variant_url = product_url | append: '?variant=' | append: variant.id
          assign variant_sku_source = variant.sku | default: variant.id
          assign variant_schema_sku = variant_sku_source | handleize | upcase
          assign variant_price = variant.price | money_without_currency | strip_html | remove: ','
          assign variant_currency = cart.currency.iso_code | default: shop.currency
        -%}
        {
          "@type": "Offer",
          "@id": {{ variant_url | append: '#offer' | json }},
          "url": {{ variant_url | json }},
          "sku": {{ variant_schema_sku | json }},
          "price": {{ variant_price }},
          "priceCurrency": {{ variant_currency | json }},
          "itemCondition": "https://schema.org/NewCondition",
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "seller": {
            "@type": "Organization",
            "name": {{ shop.name | json }}
          },
          "shippingDetails": {
            "@type": "OfferShippingDetails",
            "name": "Standard shipping",
            "shippingRate": {
              "@type": "MonetaryAmount",
              "value": "0",
              "currency": {{ variant_currency | json }}
            },
            "shippingDestination": {
              "@type": "DefinedRegion",
              "addressCountry": "US"
            },
            "deliveryTime": {
              "@type": "ShippingDeliveryTime",
              "handlingTime": {
                "@type": "QuantitativeValue",
                "minValue": 1,
                "maxValue": 2,
                "unitCode": "DAY"
              },
              "transitTime": {
                "@type": "QuantitativeValue",
                "minValue": 10,
                "maxValue": 18,
                "unitCode": "DAY"
              }
            },
            "hasShippingService": {
              "@id": {{ shipping_policy_url | append: '#policy' | json }}
            }
          },
          "hasMerchantReturnPolicy": {
            "@type": "MerchantReturnPolicy",
            "merchantReturnLink": {{ return_policy_url | json }},
            "applicableCountry": "US",
            "returnPolicyCountry": "US",
            "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
            "merchantReturnDays": 14,
            "returnMethod": "https://schema.org/ReturnByMail",
            "returnFees": "https://schema.org/ReturnFeesCustomerResponsibility",
            "refundType": "https://schema.org/FullRefund"
          }
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
</script>
