{% doc %}
Renders store-level and collection-level structured data for search engines.
{% enddoc %}

{%- liquid
  assign canonical_origin = 'https://migmaster.shop'
  assign clean_canonical_url = canonical_url | append: '' | replace: '/a/shop', ''
  if template contains 'collection' and collection.handle != blank
    assign clean_canonical_url = canonical_origin | append: '/collections/' | append: collection.handle
  endif
-%}

{%- capture social_profiles -%}
  {%- assign first_profile = true -%}
  {%- if settings.social_twitter_link != blank -%}
    {{- settings.social_twitter_link | json -}}
    {%- assign first_profile = false -%}
  {%- endif -%}
  {%- if settings.social_facebook_link != blank -%}
    {%- unless first_profile -%},{%- endunless -%}{{- settings.social_facebook_link | json -}}
    {%- assign first_profile = false -%}
  {%- endif -%}
  {%- if settings.social_instagram_link != blank -%}
    {%- unless first_profile -%},{%- endunless -%}{{- settings.social_instagram_link | json -}}
    {%- assign first_profile = false -%}
  {%- endif -%}
  {%- if settings.social_tiktok_link != blank -%}
    {%- unless first_profile -%},{%- endunless -%}{{- settings.social_tiktok_link | json -}}
    {%- assign first_profile = false -%}
  {%- endif -%}
  {%- if settings.social_youtube_link != blank -%}
    {%- unless first_profile -%},{%- endunless -%}{{- settings.social_youtube_link | json -}}
  {%- endif -%}
{%- endcapture -%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": {{ request.origin | append: '#organization' | json }},
    "name": {{ shop.name | json }},
    "url": {{ request.origin | json }}
    {%- if settings.logo != blank -%},
      "logo": {
        "@type": "ImageObject",
        "url": {{ settings.logo | image_url: width: 500 | prepend: 'https:' | json }},
        "width": {{ settings.logo.width | json }},
        "height": {{ settings.logo.height | json }}
      }
    {%- endif -%}
    {%- if social_profiles != blank -%},
      "sameAs": [{{ social_profiles }}]
    {%- endif -%}
  }
</script>

{%- if request.page_type == 'index' -%}
  {%- assign search_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": {{ request.origin | append: '#website' | json }},
      "url": {{ request.origin | json }},
      "name": {{ shop.name | json }},
      "publisher": { "@id": {{ request.origin | append: '#organization' | json }} },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ search_target | json }},
        "query-input": "required name=search_term_string"
      }
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'collection' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "@id": {{ clean_canonical_url | append: '#collection' | json }},
      "url": {{ clean_canonical_url | json }},
      "name": {{ collection.title | json }},
      "description": {{ collection.description | strip_html | strip_newlines | json }},
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": {{ collection.products_count | json }},
        "itemListElement": [
          {%- for item_product in collection.products limit: 50 -%}
            {
              "@type": "ListItem",
              "position": {{ forloop.index | json }},
              "name": {{ item_product.title | json }},
              "url": {{ request.origin | append: item_product.url | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'page' and page.handle == 'mig-flash-v2-buying-guide' -%}
  {%- assign buying_guide_url = request.origin | append: '/pages/mig-flash-v2-buying-guide' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "@id": {{ buying_guide_url | append: '#faq' | json }},
      "url": {{ buying_guide_url | json }},
      "name": "Mig Flash V2 Buying Guide FAQ",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is MigFlash V2 the same as Mig Flash V2?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Some shoppers search for this model as MigFlash V2, MIGFlash V2, migflashv2, or migflash v2. On MIG Master, the product page uses the name Mig Flash V2."
          }
        },
        {
          "@type": "Question",
          "name": "Does the package include a microSD card or cartridges?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. The product page sells the hardware accessory only unless a bundle explicitly says otherwise."
          }
        },
        {
          "@type": "Question",
          "name": "Where should I check current compatibility?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Review the current Mig Flash V2 product page and any linked support resources before ordering or updating related hardware."
          }
        },
        {
          "@type": "Question",
          "name": "How long does shipping usually take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Orders are generally processed within 1 to 2 business days, with standard delivery commonly estimated at 10 to 18 business days after processing. Actual delivery can vary."
          }
        }
      ]
    }
  </script>
{%- endif -%}
