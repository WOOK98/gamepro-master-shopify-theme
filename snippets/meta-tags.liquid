{%- liquid
  assign canonical_origin = 'https://migmaster.shop'
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | append: '' | replace: '/a/shop', '' | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name
  assign default_share_image = 'mig-flash-icon-512.png' | asset_url

  if template contains 'product'
    assign og_type = 'product'
    assign og_url = canonical_origin | append: '/products/' | append: product.handle
  elsif template contains 'article'
    assign og_type = 'article'
    assign og_url = canonical_origin | append: article.url
  elsif template contains 'collection'
    assign og_url = canonical_origin | append: '/collections/' | append: collection.handle
  elsif template contains 'page'
    assign og_url = canonical_origin | append: '/pages/' | append: page.handle
  elsif template contains 'password'
    assign og_url = request.origin
  endif

  if page_image
    assign og_image_width = page_image.width | at_most: 1200
    assign og_image_height = og_image_width | divided_by: page_image.aspect_ratio | round
  endif
%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if page_image -%}
  <meta property="og:image" content="http:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="{{ og_image_width }}">
  <meta property="og:image:height" content="{{ og_image_height }}">
  <meta property="og:image:alt" content="{{ page_image.alt | default: og_title | escape }}">
{%- else -%}
  <meta property="og:image" content="https:{{ default_share_image }}">
  <meta property="og:image:secure_url" content="https:{{ default_share_image }}">
  <meta property="og:image:width" content="512">
  <meta property="og:image:height" content="512">
  <meta property="og:image:alt" content="{{ shop.name | escape }} logo">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if page_image -%}
  <meta name="twitter:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta name="twitter:image:alt" content="{{ page_image.alt | default: og_title | escape }}">
{%- else -%}
  <meta name="twitter:image" content="https:{{ default_share_image }}">
  <meta name="twitter:image:alt" content="{{ shop.name | escape }} logo">
{%- endif -%}
